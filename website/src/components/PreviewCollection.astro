<!-- Elements created at runtime (iframe, error box) never carry Astro's
     scoping attribute, so their rules must live in a global block. -->
<style is:global>
  /* Runtime-created posters (state/theme swaps) carry no Astro scope
     attribute, so the shared media rules live here. */
  .pv-media {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
    background: var(--md-surface-container-lowest);
  }
  .pv-media[hidden] {
    display: none;
  }
  .pv-live {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    border: 0;
    /* The iframe lays out at the scene's logical width and is scaled via
       transform — the global img/iframe max-width rule must not shrink it. */
    max-width: none;
    background: var(--md-surface-container-lowest);
  }
  .pv-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 100%;
    color: var(--md-on-surface-variant);
    font-size: 0.9rem;
  }
  .pv-error .pv-try {
    border: 1px solid var(--md-primary);
    background: var(--md-primary);
    color: var(--md-on-primary);
    border-radius: 999px;
    min-height: 44px;
    padding: 0 14px;
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
  }
</style>
