    <string name="setup_welcome_subtitle">Your private, on-device gallery</string>

    <string name="setup_permissions_title">Show me your photos</string>
    <string name="setup_permissions_subtitle">ReFra only asks for what it needs. The rest is optional.</string>
    <string name="setup_reason_read_images">Displaying your photos in the timeline, albums and viewer. Without this, the gallery stays empty.</string>
    <string name="setup_reason_read_videos">Showing and playing your videos in the timeline, albums and viewer.</string>
    <string name="setup_reason_media_location_optional">Optional. Allows ReFra to read GPS data embedded in photos and videos for the Map and location details. Your gallery still works if you skip it.</string>
    <string name="setup_reason_internet">Downloading map tiles for location previews, casting media to nearby devices, downloading optional AI models and syncing with cloud servers. Media never leaves your device unless you set up cloud sync.</string>
    <string name="setup_reason_local_network">Optional. Grant this only when ReFra connects directly to a server on your current network.</string>
    <string name="setup_reason_notifications">Showing progress for background tasks such as backups, encryption and downloads.</string>
    <string name="setup_reason_manage_media">Skipping the extra system confirmation dialog when you favorite, trash or edit several items at once.</string>
    <string name="setup_reason_manage_files">Creating albums outside the standard Pictures and DCIM folders, managing files anywhere on your storage, and showing extra photo formats the system doesn't recognize (such as JPEG XL, JPEG 2000 and Photoshop files).</string>

